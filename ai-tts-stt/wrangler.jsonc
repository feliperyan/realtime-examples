/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fryan-cf-realtime-audio-2",
	"main": "src/index.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-08-06",
	"migrations": [
		{
			"new_sqlite_classes": [
				"TTSAdapter"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"STTAdapter"
			],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": [
				"LiveAgent"
			],
			"tag": "v3"
		},
	],
	"assets": {
		"directory": "public"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "TTSAdapter",
				"name": "TTS_ADAPTER"
			},
			{
				"class_name": "STTAdapter",
				"name": "STT_ADAPTER"
			},
			{
				"class_name": "LiveAgent",
				"name": "LIVE_AGENT"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"SFU_API_BASE": "https://rtc.live.cloudflare.com/v1",
		"CF_ACCOUNT": "14c3ac5c1b9c191facc9a1e2247ec5b9",
		"REALTIME_SFU_APP_ID": "a05bf305f4b3f0010d721cc126f1805c",
	}
}